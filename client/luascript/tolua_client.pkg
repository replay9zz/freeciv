$#ifdef HAVE_CONFIG_H
$#include <fc_config.h>
$#endif

/* common/scriptcore */
$#include "luascript_types.h"

/* client/luascript */
$#include "api_client_base.h"
$#include "api_client_actions.h"
$#include "script_client.h"

/* Chat module. */

module chat {
  void api_client_chat_base
    @ base (lua_State *L, const char *message);
  bool api_client_chat_send
    @ send (lua_State *L, const char *message);
}

module client {
  bool api_client_move_dir
    @ move_dir (lua_State *L, int unit_id, int dir8);
  bool api_client_build_city
    @ build_city (lua_State *L, int unit_id);
  bool api_client_found_city
    @ found_city (lua_State *L, int unit_id, const char *city_name);
  bool api_client_set_city_production
    @ set_city_production (lua_State *L, int city_id, const char *kind, const char *rule_name);
  bool api_client_queue_city_production
    @ queue_city_production (lua_State *L, int city_id, const char *kind, const char *rule_name, int position);
  int api_client_city_production_cost
    @ city_production_cost (lua_State *L, int city_id, const char *kind, const char *rule_name);
  int api_client_city_production_turns
    @ city_production_turns (lua_State *L, int city_id, const char *kind, const char *rule_name, bool include_shield_stock);
  int api_client_city_shield_stock
    @ city_shield_stock (lua_State *L, int city_id);
  int api_client_city_shield_surplus
    @ city_shield_surplus (lua_State *L, int city_id);
  bool api_client_end_turn
    @ end_turn (lua_State *L);
  bool api_client_start_revolution
    @ start_revolution (lua_State *L);
  bool api_client_set_government
    @ set_government (lua_State *L, const char *gov_identifier);
  bool api_client_auto_settler
    @ auto_settler (lua_State *L, int unit_id);
  bool api_client_can_unit_activity
    @ can_unit_activity (lua_State *L, int unit_id, const char *activity_name);
  int api_client_unit_activity_id
    @ unit_activity_id (lua_State *L, int unit_id);
  bool api_client_unit_activity
    @ unit_activity (lua_State *L, int unit_id, const char *activity_name);
  bool api_client_upgrade_unit
    @ upgrade_unit (lua_State *L, int unit_id);
  bool api_client_attack_native
    @ attack (lua_State *L, int unit_id, int nat_x, int nat_y);
  bool api_client_attack_tile
    @ attack_tile (lua_State *L, int unit_id, int tile_index);
  bool api_client_attack_dir
    @ attack_dir (lua_State *L, int unit_id, int dir8);
  bool api_client_attack_dir_gui
    @ attack_dir_gui (lua_State *L, int unit_id, int gui_dir8);
  bool api_client_attack_city
    @ attack_city (lua_State *L, int unit_id, int city_id);
  bool api_client_conquer_city
    @ conquer_city (lua_State *L, int unit_id, int city_id);
  bool api_client_set_research
    @ set_research (lua_State *L, int player_id, const char *tech_identifier);
  bool api_client_set_research_goal
    @ set_research_goal (lua_State *L, int player_id, const char *tech_identifier);
  int api_client_tile_known
    @ tile_known (lua_State *L, int tile_index);
  bool api_client_tile_seen
    @ tile_seen (lua_State *L, int tile_index, int vlayer);
  int api_client_unit_vision_radius_sq
    @ unit_vision_radius_sq (lua_State *L, int unit_id);
}


