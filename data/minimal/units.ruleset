[unit_diplomat]
name          = _("Diplomat")
class         = "Small Land"
reqs          =
  { "type", "name", "range"
    "Tech", "Alphabet", "Player"
  }
;obsolete_by   = "Spy"
graphic       = "u.diplomat"
graphic_alt   = "-"
sound_move    = "m_diplomat"
sound_move_alt = "m_generic"
sound_fight   = "f_diplomat"
sound_fight_alt = "f_generic"
