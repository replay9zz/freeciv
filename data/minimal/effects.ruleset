; Any city can support up to four units...
[effect_upkeep_free_units_food_base]
type    = "Unit_Upkeep_Free_Per_City"
value   = 4
reqs    =
    { "type", "name", "range"
      "OutputType", "Food", "Local"
    }

; ...or its size, whichever is bigger. Units above this limit have a
